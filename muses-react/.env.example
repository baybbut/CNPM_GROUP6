# Local Vite proxy for /api and /images.
API_PROXY_TARGET=http://127.0.0.1:3001
# Empty for local proxy and same-origin production.
# Separate backend: set its public HTTPS origin BEFORE npm run build.
VITE_API_BASE_URL=
# Optional reachable homepage origin for the website access QR in /scan.
# Empty: current origin; localhost uses the supplied Wi-Fi demo address.
# For a different LAN IP or a public deployment, set its HTTP(S) origin here.
VITE_VISITOR_BASE_URL=
