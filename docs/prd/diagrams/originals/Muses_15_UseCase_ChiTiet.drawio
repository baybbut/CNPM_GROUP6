tra. Tác phẩm nháp hoặc ẩn không được xem công khai." style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=22;strokeColor=#222222;fillColor=#FFFFFF;strokeColor=none;fillColor=none;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry as="geometry" x="250" y="900" width="1260" height="150" /></mxCell></root></mxGraphModel></diagram><diagram id="UC03" name="UC03 Chuyển ngôn ngữ"><mxGraphModel page="1" pageWidth="1600" pageHeight="1100" grid="1" gridSize="10"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="sys" value="MUSES" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=22;strokeColor=#222222;fillColor=#FFFFFF;verticalAlign=top;spacingTop=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="240" y="95" width="1290" height="780" /></mxCell><mxCell id="actor" value="Khách tra cứu" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=22;strokeColor=#222222;fillColor=#FFFFFF;shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="380" width="110" height="190" /></mxCell><mxCell id="main" value="UC03&#10;Chuyển ngôn ngữ" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=22;strokeColor=#222222;fillColor=#FFFFFF;ellipse;" vertex="1" parent="1"><mxGeometry as="geometry" x="340" y="425" width="430" height="105" /></mxCell><mxCell id="association" source="actor" target="main" value="" edge="1" parent="1" style="html=0;strokeColor=#333333;fontFamily=Arial;fontSize=20;endArrow=none;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s0" value="Hiển thị nội dung theo&#10;ngôn ngữ thực tế" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=22;strokeColor=#222222;fillColor=#FFFFFF;ellipse;" vertex="1" parent="1"><mxGeometry as="geometry" x="1030" y="170.0" width="440" height="86" /></mxCell><mxCell id="r0" source="main" target="s0" value="«include»" edge="1" parent="1" style="html=0;strokeColor=#333333;fontFamily=Arial;fontSize=20;dashed=1;