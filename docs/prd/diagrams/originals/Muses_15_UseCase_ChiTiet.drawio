erticalLabelPosition=bottom;verticalAlign=top;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="380" width="110" height="190" /></mxCell><mxCell id="main" value="UC06&#10;Tra cứu bảo tàng" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=22;strokeColor=#222222;fillColor=#FFFFFF;ellipse;" vertex="1" parent="1"><mxGeometry as="geometry" x="340" y="425" width="430" height="105" /></mxCell><mxCell id="association" source="actor" target="main" value="" edge="1" parent="1" style="html=0;strokeColor=#333333;fontFamily=Arial;fontSize=20;endArrow=none;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s0" value="Tìm bảo tàng theo tên" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=22;strokeColor=#222222;fillColor=#FFFFFF;ellipse;" vertex="1" parent="1"><mxGeometry as="geometry" x="1030" y="170.0" width="440" height="86" /></mxCell><mxCell id="r0" source="main" target="s0" value="«include»" edge="1" parent="1" style="html=0;strokeColor=#333333;fontFamily=Arial;fontSize=20;dashed=1;endArrow=open;endFill=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s1" value="Xem chi tiết bảo tàng" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=22;strokeColor=#222222;fillColor=#FFFFFF;ellipse;" vertex="1" parent="1"><mxGeometry as="geometry" x="1030" y="470.0" width="440" height="86" /></mxCell><mxCell id="r1" source="s1" target="main" value="«extend»" edge="1" parent="1" style="html=0;strokeColor=#333333;fontFamily=Arial;fontSize=20;dashed=1;endArrow=open;endFill=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s2" value="Xem tác phẩm đang&#10;trưng bày tại bảo tàng" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=22;strokeColor=#222222;fillColor=#FFFFFF;ellipse;" vertex="1" parent="1"><mxGeometry as="geometry" x="1030" y="770.0" width="440" height="86" /></mxCell><mxCell id="r2" source="s2" target="main" value="«extend»" edge="1" parent="1" style="html=0;strokeColor=#333333;fontFamily=Arial;fontSize=20;dashed=1;endArrow=open;endFill=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="note" value="Ghi chú: Mở chi tiết khi khách chọn một bảo tàng trong kết quả; xem tác phẩm khi khách yêu cầu danh sách của bảo tàng đã chọn. Chỉ hiển thị dữ liệu công khai." style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=22;strokeColor=#222222;fillColor=#FFFFFF;strokeColor=none;fillColor=none;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry as="geometry" x="250" y="900" width="1260" height="150" /></mxCell></root></mxGraphModel></diagram><diagram id="UC07" name="UC07 Xem bản đồ bảo tàng"><mxGraphModel page="1" pageWidth="1600" pageHeight="1100" grid="1" gridSize="10"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="sys" value="MUSES" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=22;strokeColor=#222222;fillColor=#FFFFFF;verticalAlign=top;spacingTop=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="240" y="95" width="1290" height="780" /></mxCell><mxCell id="actor" value="Khách tra cứu" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=22;strokeColor=#222222;fillColor=#FFFFFF;shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="380" width="110" height="190" /></mxCell><mxCell id="main" value="UC07&#10;Xem bản đồ bảo tàng" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=22;strokeColor=#222222;fillColor=#FFFFFF;ellipse;" vertex="1" parent="1"><mxGeometry as="geometry" x="340" y="425" width="430" height="105" /></mxCell><mxCell id="association" source="actor" target="main" value="" edge="1" parent="1" style="html=0;strokeColor=#333333;fontFamily=Arial;fontSize=20;endArrow=none;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s0" value="Hiển thị ghim bảo tàng" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=22;strokeColor=#222222;fillColor=#FFFFFF;ellipse;" vertex="1" parent="1"><mxGeometry as="geometry" x="1030" y="170.0" width="440" height="86" /></mxCell><mxCell id="r0" source="main" target="s0" value="«include»" edge="1" parent="1" style="html=0;strokeColor=#333333;fontFamily=Arial;fontSize=20;dashed=1;endArrow=open;endFill=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s1" value="Xem thông tin ghim" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=22;strokeColor=#222222;fillColor=#FFFFFF;ellipse;" vertex="1" parent="1"><mxGeometry as="geometry" x="1030" y="470.0" width="440" height="86" /></mxCell><mxCell id="r1" source="s1" target="main" value="«extend»" edge="1" parent="1" style="html=0;strokeColor=#333333;fontFamily=Arial;fontSize=20;dashed=1;endArrow=open;endFill=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s2" value="UC08 — Mở chỉ đường" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=22;strokeColor=#222222;fillColor=#FFFFFF;ellipse;" vertex="1" parent="1"><mxGeometry as="geometry" x="1030" y="770.0" width="440" height="86" /></mxCell><mxCell id="r2" source="s2" target="main" value="«extend»" edge="1" parent="1" style="html=0;strokeColor=#333333;fontFamily=Arial;fontSize=20;dashed=1;endArrow=open;endFill=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="note" value="Ghi chú: Dùng tọa độ của bảo tàng, không cần GPS của khách. Khách có thể chọn ghim hoặc mở chỉ đường. Nếu bản đồ lỗi vẫn giữ địa chỉ và liên kết chỉ đường trên trang." style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=22;strokeColor=#222222;fillColor=#FFFFFF;strokeColor=none;fillColor=none;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry as="geometry" x="250" y="900" width="1260" height="150" /></mxCell></root></mxGraphModel></diagram><diagram id="UC08" name="UC08 Mở chỉ đường"><mxGraphModel page="1" pageWidth="1600" pageHeight="1100" grid="1" gridSize="10"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="sys" value="MUSES" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=22;strokeColor=#222222;fillColor=#FFFFFF;verticalAlign=top;spacingTop=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="240" y="95" width="1290" height="780" /></mxCell><mxCell id="actor" value="Khách tra cứu" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=22;strokeColor=#222222;fillColor=#FFFFFF;shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="380" width="110" height="190" /></mxCell><mxCell id="main" value="UC08&#10;Mở chỉ đường" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=22;strokeColor=#222222;fillColor=#FFFFFF;ellipse;" vertex="1" parent="1"><mxGeometry as="geometry" x="340" y="425" width="430" height="105" /></mxCell><mxCell id="association" source="actor" target="main" value="" edge="1" parent="1" style="html=0;strokeColor=#333333;fontFamily=Arial;fontSize=20;endArrow=none;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="note" value="Ghi chú: Tiền điều kiện: xác định được bảo tàng đích. Khi khách chọn chỉ đường, Muses mở dịch vụ bản đồ với đúng đích đến. Dịch vụ ngoài xử lý điểm xuất phát và quyền vị trí nếu cần; không mô hình hóa thao tác bên trong dịch vụ đó." style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=22;strokeColor=#222222;fillColor=#FFFFFF;strokeColor=none;fillColor=none;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry as="geometry" x="250" y="900" width="1260" height="150" /></mxCell></root></mxGraphModel></diagram><diagram id="UC09" name="UC09 Đăng nhập"><mxGraphModel page="1" pageWidth="1600" pageHeight="1100" grid="1" gridSize="10"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="sys" value="MUSES" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=22;strokeColor=#222222;fillColor=#FFFFFF;verticalAlign=top;spacingTop=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="240" y="95" width="1290" height="780" /></mxCell><mxCell id="actor" value="Quản trị viên" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=22;strokeColor=#222222;fillColor=#FFFFFF;shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="380" width="110" height="190" /></mxCell><mxCell id="main" value="UC09&#10;Đăng nhập" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=22;strokeColor=#222222;fillColor=#FFFFFF;ellipse;" vertex="1" parent="1"><mxGeometry as="geometry" x="340" y="425" width="430" height="105" /></mxCell><mxCell id="association" source="actor" target="main" value="" edge="1" parent="1" style="html=0;strokeColor=#333333;fontFamily=Arial;fontSize=20;endArrow=none;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s0" value="Xác thực thông tin&#10;đăng nhập" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=22;strokeColor=#222222;fillColor=#FFFFFF;ellipse;" vertex="1" parent="1"><mxGeometry as="geometry" x="1030" y="425" width="440" height="86" /></mxCell><mxCell id="r0" source="main" target="s0" value="«include»" edge="1" parent="1" style="html=0;strokeColor=#333333;fontFamily=Arial;fontSize=20;dashed=1;endArrow=open;endFill=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="note" value="Ghi chú: Admin nhập tài khoản và mật khẩu. Hợp lệ thì tạo phiên; sai thông tin thì báo lỗi chung và không tạo phiên. Xác thực là hành vi bắt buộc của lần đăng nhập." style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=22;strokeColor=#222222;fillColor=#FFFFFF;strokeColor=none;fillColor=none;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry as="geometry" x="250" y="900" width="1260" height="150" /></mxCell></root></mxGraphModel></diagram><diagram id="UC10" name="UC10 Quản lý tác phẩm"><mxGraphModel page="1" pageWidth="1600" pageHeight="1100" grid="1" gridSize="10"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="sys" value="MUSES" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=22;strokeColor=#222222;fillColor=#FFFFFF;verticalAlign=top;spacingTop=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="240" y="95" width="1290" height="780" /></mxCell><mxCell id="actor" value="Quản trị viên" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=22;strokeColor=#222222;fillColor=#FFFFFF;shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="380" width="110" height="190" /></mxCell><mxCell id="main" value="UC10&#10;Quản lý tác phẩm" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=22;strokeColor=#222222;fillColor=#FFFFFF;ellipse;" vertex="1" parent="1"><mxGeometry as="geometry" x="340" y="425" width="430" height="105" /></mxCell><mxCell id="association" source="actor" target="main" value="" edge="1" parent="1" style="html=0;strokeColor=#333333;fontFamily=Arial;fontSize=20;endArrow=none;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s0" value="Thêm tác phẩm ở trạng thái nháp" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=22;strokeColor=#222222;fillColor=#FFFFFF;ellipse;" vertex="1" parent="1"><mxGeometry as="geometry" x="1030" y="170.0" width="440" height="86" /></mxCell><mxCell id="r0" source="s0" target="main" value="" edge="1" parent="1" style="html=0;strokeColor=#333333;fontFamily=Arial;fontSize=20;endArrow=block;endFill=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s1" value="Sửa thông tin tác phẩm" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=22;strokeColor=#222222;fillColor=#FFFFFF;ellipse;" vertex="1" parent="1"><mxGeometry as="geometry" x="1030" y="370.0" width="440" height="86" /></mxCell><mxCell id="r1" source="s1" target="main" value="" edge="1" parent="1" style="html=0;strokeColor=#333333;fontFamily=Arial;fontSize=20;endArrow=block;endFill=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s2" value="Công bố tác phẩm" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=22;strokeColor=#222222;fillColor=#FFFFFF;ellipse;" vertex="1" parent="1"><mxGeometry as="geometry" x="1030" y="570.0" width="440" height="86" /></mxCell><mxCell id="r2" source="s2" target="main" value="" edge="1" parent="1" style="html=0;strokeColor=#333333;fontFamily=Arial;fontSize=20;endArrow=block;endFill=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s3" value="Ẩn tác phẩm" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=22;strokeColor=#222222;fillColor=#FFFFFF;ellipse;" vertex="1" parent="1"><mxGeometry as="geometry" x="1030" y="770.0" width="440" height="86" /></mxCell><mxCell id="r3" source="s3" target="main" value="" edge="1" parent="1" style="html=0;strokeColor=#333333;fontFamily=Arial;fontSize=20;endArrow=block;endFill=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="note" value="Ghi chú: Tiền điều kiện: admin đăng nhập hợp lệ. Đây là các mục tiêu quản trị chuyên biệt, không phải các bước luôn chạy cùng nhau. Công bố yêu cầu tên và mô tả tiếng Việt; giữ dữ liệu nhập khi lưu lỗi." style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=22;strokeColor=#222222;fillColor=#FFFFFF;strokeColor=none;fillColor=none;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry as="geometry" x="250" y="900" width="1260" height="150" /></mxCell></root></mxGraphModel></diagram><diagram id="UC11" name="UC11 Quản lý bản dịch"><mxGraphModel page="1" pageWidth="1600" pageHeight="1100" grid="1" gridSize="10"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="sys" value="MUSES" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=22;strokeColor=#222222;fillColor=#FFFFFF;verticalAlign=top;spacingTop=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="240" y="95" width="1290" height="780" /></mxCell><mxCell id="actor" value="Quản trị viên" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=22;strokeColor=#222222;fillColor=#FFFFFF;shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="380" width="110" height="190" /></mxCell><mxCell id="main" value="UC11&#10;Quản lý bản dịch" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=22;strokeColor=#222222;fillColor=#FFFFFF;ellipse;" vertex="1" parent="1"><mxGeometry as="geometry" x="340" y="425" width="430" height="105" /></mxCell><mxCell id="association" source="actor" target="main" value="" edge="1" parent="1" style="html=0;strokeColor=#333333;fontFamily=Arial;fontSize=20;endArrow=none;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s0" value="Thêm bản dịch" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=22;strokeColor=#222222;fillColor=#FFFFFF;ellipse;" vertex="1" parent="1"><mxGeometry as="geometry" x="1030" y="170.0" width="440" height="86" /></mxCell><mxCell id="r0" source="s0" target="main" value="" edge="1" parent="1" style="html=0;strokeColor=#333333;fontFamily=Arial;fontSize=20;endArrow=block;endFill=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s1" value="Sửa bản dịch" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=22;strokeColor=#222222;fillColor=#FFFFFF;ellipse;" vertex="1" parent="1"><mxGeometry as="geometry" x="1030" y="470.0" width="440" height="86" /></mxCell><mxCell id="r1" source="s1" target="main" value="" edge="1" parent="1" style="html=0;strokeColor=#333333;fontFamily=Arial;fontSize=20;endArrow=block;endFill=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s2" value="Công bố bản dịch" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=22;strokeColor=#222222;fillColor=#FFFFFF;ellipse;" vertex="1" parent="1"><mxGeometry as="geometry" x="1030" y="770.0" width="440" height="86" /></mxCell><mxCell id="r2" source="s2" target="main" value="" edge="1" parent="1" style="html=0;strokeColor=#333333;fontFamily=Arial;fontSize=20;endArrow=block;endFill=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="note" value="Ghi chú: Tiền điều kiện: admin đăng nhập hợp lệ. Một tác phẩm chỉ có một bản dịch cho mỗi ngôn ngữ. Bản dịch nháp không phục vụ khách; nội dung đọc lấy từ bản đã công bố." style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=22;strokeColor=#222222;fillColor=#FFFFFF;strokeColor=none;fillColor=none;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry as="geometry" x="250" y="900" width="1260" height="150" /></mxCell></root></mxGraphModel></diagram><diagram id="UC12" name="UC12 Quản lý bảo tàng"><mxGraphModel page="1" pageWidth="1600" pageHeight="1100" grid="1" gridSize="10"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="sys" value="MUSES" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=22;strokeColor=#222222;fillColor=#FFFFFF;verticalAlign=top;spacingTop=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="240" y="95" width="1290" height="780" /></mxCell><mxCell id="actor" value="Quản trị viên" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=22;strokeColor=#222222;fillColor=#FFFFFF;shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="380" width="110" height="190" /></mxCell><mxCell id="main" value="UC12&#10;Quản lý bảo tàng" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=22;strokeColor=#222222;fillColor=#FFFFFF;ellipse;" vertex="1" parent="1"><mxGeometry as="geometry" x="340" y="425" width="430" height="105" /></mxCell><mxCell id="association" source="actor" target="main" value="" edge="1" parent="1" style="html=0;strokeColor=#333333;fontFamily=Arial;fontSize=20;endArrow=none;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s0" value="Thêm bảo tàng" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=22;strokeColor=#222222;fillColor=#FFFFFF;ellipse;" vertex="1" parent="1"><mxGeometry as="geometry" x="1030" y="170.0" width="440" height="86" /></mxCell><mxCell id="r0" source="s0" target="main" value="" edge="1" parent="1" style="html=0;strokeColor=#333333;fontFamily=Arial;fontSize=20;endArrow=