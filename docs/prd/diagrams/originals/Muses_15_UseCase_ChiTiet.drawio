<mxfile host="app.diagrams.net" version="24.7.17"><diagram id="UC01" name="UC01 Tra cứu tác phẩm"><mxGraphModel page="1" pageWidth="1600" pageHeight="1100" grid="1" gridSize="10"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="sys" value="MUSES" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=22;strokeColor=#222222;fillColor=#FFFFFF;verticalAlign=top;spacingTop=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="240" y="95" width="1290" height="780" /></mxCell><mxCell id="actor" value="Khách tra cứu" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=22;strokeColor=#222222;fillColor=#FFFFFF;shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="380" width="110" height="190" /></mxCell><mxCell id="main" value="UC01&#10;Tra cứu tác phẩm" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=22;strokeColor=#222222;fillColor=#FFFFFF;ellipse;" vertex="1" parent="1"><mxGeometry as="geometry" x="340" y="425" width="430" height="105" /></mxCell><mxCell id="association" source="actor" target="main" value="" edge="1" parent="1" style="html=0;strokeColor=#333333;fontFamily=Arial;fontSize=20;endArrow=none;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s0" value="Tìm theo tên tác phẩm" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=22;strokeColor=#222222;fillColor=#FFFFFF;ellipse;" vertex="1" parent="1"><mxGeometry as="geometry" x="1030" y="170.0" width="440" height="86" /></mxCell><mxCell id="r0" source="main" target="s0" value="«include»" edge="1" parent="1" style="html=0;strokeColor=#333333;fontFamily=Arial;fontSize=20;dashed=1;endArrow=open;endFill=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s1" value="Lọc kết quả tra cứu" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=22;strokeColor=#222222;fillColor=#FFFFFF;ellipse;" vertex="1" parent="1"><mxGeometry as="geometry" x="1030" y="470.0" width="440" height="86"