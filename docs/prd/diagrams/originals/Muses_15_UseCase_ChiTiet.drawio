 value="Quản trị viên" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=22;strokeColor=#222222;fillColor=#FFFFFF;shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="380" width="110" height="190" /></mxCell><mxCell id="main" value="UC15&#10;Đăng xuất" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=22;strokeColor=#222222;fillColor=#FFFFFF;ellipse;" vertex="1" parent="1"><mxGeometry as="geometry" x="340" y="425" width="430" height="105" /></mxCell><mxCell id="association" source="actor" target="main" value="" edge="1" parent="1" style="html=0;strokeColor=#333333;fontFamily=Arial;fontSize=20;endArrow=none;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="note" value="Ghi chú: Tiền điều kiện: admin đang có phiên hợp lệ. Kết quả: phiên kết thúc, quay về trang đăng nhập hoặc trang công khai; thông tin xác thực cũ không còn dùng được cho API quản trị. UC đơn giản được giữ nguyên, không tách bước giao diện thành UC giả." style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=22;strokeColor=#222222;fillColor=#FFFFFF;strokeColor=none;fillColor=none;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry as="geometry" x="250" y="900" width="1260" height="150" /></mxCell></root></mxGraphModel></diagram></mxfile>