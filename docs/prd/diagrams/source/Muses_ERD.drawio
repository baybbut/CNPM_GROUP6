        <mxCell id="n54" value="Lịch hiện tại: Confirmed và StartDate ≤ ngày Việt Nam &lt; EndDate; EndDate NULL = không giới hạn.&#10;Không cho lịch Confirmed của cùng hiện vật chồng nhau (kiểm tra trong giao dịch)." style="fontFamily=Arial;html=0;convertToSvg=1;svgWhiteSpace=wrap;fontColor=#172B3A;rounded=0;whiteSpace=wrap;fillColor=#FFF7E7;strokeColor=#C5AB7C;strokeWidth=1.5;fontSize=21;spacing=16;align=left;verticalAlign=middle;spacing=20;" vertex="1" parent="1">
