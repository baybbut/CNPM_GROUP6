        <mxCell id="n54" value="Kind = page_view / qr_scan / audio_play. Heartbeat chỉ cập nhật phiên, không tạo loại sự kiện mới.&#10;VisitorID, PointKey và AnalyticsEvents.LanguageCode là giá trị, không có FK tới bảng riêng." style="fontFamily=Arial;html=0;convertToSvg=1;svgWhiteSpace=wrap;fontColor=#172B3A;rounded=0;whiteSpace=wrap;fillColor=#FFF7E7;strokeColor=#C5AB7C;strokeWidth=1.5;fontSize=21;spacing=16;align=left;verticalAlign=middle;spacing=20;" vertex="1" parent="1">
          <mxGeometry x="60" y="1260" width="1870" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n55" value="AnalyticsSessions khác AuthSessions: khách ẩn danh vẫn có phiên truy cập. Thời gian sự kiện lưu UTC, báo cáo lọc UTC+7.&#10;GPS của khách không lưu vào các bảng này. AuthLoginEvents còn trong DB dù 3 thẻ thống kê đăng nhập đã bỏ khỏi UI." style="fontFamily=Arial;html=0;convertToSvg=1;svgWhiteSpace=wrap;fontColor=#172B3A;rounded=0;whiteSpace=wrap;fillColor=#FFF7E7;strokeColor=#C5AB7C;strokeWidth=1.5;fontSize=21;spacing=16;align=left;verticalAlign=middle;spacing=20;" vertex="1" parent="1">
          <mxGeometry x="60" y="1380" width="1870" height="100" as="geometry" />
        </mxCell>
