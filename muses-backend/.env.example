# SQL authentication, e.g. SQL Server Docker published on localhost:1433.
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=MusesMuseumDB
DB_USER=sa
DB_PASSWORD=
DB_ENCRYPT=true
# Local self-signed Docker certificate only. Use false with a valid production certificate.
DB_TRUST_SERVER_CERTIFICATE=true
PORT=3001
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Local LibreTranslate Docker service (see docs/QR-TRANSLATION.md)
TRANSLATE_ENABLED=true
TRANSLATE_URL=http://127.0.0.1:5000
