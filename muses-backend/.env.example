# SQL authentication, e.g. SQL Server Docker published on localhost:1433.
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=MusesMuseumDB
DB_USER=muses_app
DB_PASSWORD=
DB_ENCRYPT=true
# Local self-signed Docker certificate only. Use false with a valid production certificate.
DB_TRUST_SERVER_CERTIFICATE=true
PORT=3001
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# PRD MVP uses manually reviewed translations. LibreTranslate is not required.
# Keep SQL administrator credentials out of this file; enter them only for setup.

# Ticket QR defaults to a non-payment demonstration. Never put these secrets in VITE_*.
TICKET_PAYMENT_MODE=demo
# Optional future VNPAY configuration (merchant required; keep mode=demo for sample QR):
# VNPAY_TMN_CODE=
# VNPAY_HASH_SECRET=
# VNPAY_RETURN_URL=http://localhost:5173/tickets/result
# VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
